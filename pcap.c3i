module libpcap::pcap;
import libpcap::bpf;

const PCAP_VERSION_MAJOR = 2;
const PCAP_VERSION_MINOR = 4;
const PCAP_ERRBUF_SIZE   = 256;

const PCAP_IF_LOOPBACK                         =  0x00000001;
const PCAP_IF_UP                               =  0x00000002;
const PCAP_IF_RUNNING                          =  0x00000004;
const PCAP_IF_WIRELESS                         =  0x00000008;
const PCAP_IF_CONNECTION_STATUS                =  0x00000030;
const PCAP_IF_CONNECTION_STATUS_UNKNOWN        =  0x00000000;
const PCAP_IF_CONNECTION_STATUS_CONNECTED      =  0x00000010;
const PCAP_IF_CONNECTION_STATUS_DISCONNECTED   =  0x00000020;
const PCAP_IF_CONNECTION_STATUS_NOT_APPLICABLE =  0x00000030;
const PCAP_ERROR                               = -1;
const PCAP_ERROR_BREAK                         = -2;
const PCAP_ERROR_NOT_ACTIVATED                 = -3;
const PCAP_ERROR_ACTIVATED                     = -4;
const PCAP_ERROR_NO_SUCH_DEVICE                = -5;
const PCAP_ERROR_RFMON_NOTSUP                  = -6;
const PCAP_ERROR_NOT_RFMON                     = -7;
const PCAP_ERROR_PERM_DENIED                   = -8;
const PCAP_ERROR_IFACE_NOT_UP                  = -9;
const PCAP_ERROR_CANTSET_TSTAMP_TYPE           = -10;
const PCAP_ERROR_PROMISC_PERM_DENIED           = -11;
const PCAP_ERROR_TSTAMP_PRECISION_NOTSUP       = -12;
const PCAP_ERROR_CAPTURE_NOTSUP                = -13;
const PCAP_WARNING                             =  1;
const PCAP_WARNING_PROMISC_NOTSUP              =  2;
const PCAP_WARNING_TSTAMP_TYPE_NOTSUP          =  3;
const PCAP_NETMASK_UNKNOWN                     =  0xffffffff;
const PCAP_CHAR_ENC_LOCAL                      =  0x00000000U;
const PCAP_CHAR_ENC_UTF_8                      =  0x00000001U;
const PCAP_MMAP_32BIT                          =  0x00000002U;
const PCAP_TSTAMP_HOST                         =  0;
const PCAP_TSTAMP_HOST_LOWPREC                 =  1;
const PCAP_TSTAMP_HOST_HIPREC                  =  2;
const PCAP_TSTAMP_ADAPTER                      =  3;
const PCAP_TSTAMP_ADAPTER_UNSYNCED             =  4;
const PCAP_TSTAMP_HOST_HIPREC_UNSYNCED         =  5;
const PCAP_TSTAMP_PRECISION_MICRO              =  0;
const PCAP_TSTAMP_PRECISION_NANO               =  1;
const PCAP_BUF_SIZE                            =  1024;
const PCAP_SRC_FILE                            =  2;
const PCAP_SRC_IFLOCAL                         =  3;
const PCAP_SRC_IFREMOTE                        =  4;
const PCAP_SRC_FILE_STRING                     =  "file://";
const PCAP_SRC_IF_STRING                       =  "rpcap://";
const PCAP_OPENFLAG_PROMISCUOUS                =  0x00000001;
const PCAP_OPENFLAG_DATATX_UDP                 =  0x00000002;
const PCAP_OPENFLAG_NOCAPTURE_RPCAP            =  0x00000004;
const PCAP_OPENFLAG_NOCAPTURE_LOCAL            =  0x00000008;
const PCAP_OPENFLAG_MAX_RESPONSIVENESS         =  0x00000010;
const RPCAP_RMTAUTH_NULL                       =  0;
const RPCAP_RMTAUTH_PWD                        =  1;
const PCAP_SAMP_NOSAMP                         =  0;
const PCAP_SAMP_1_EVERY_N                      =  1;
const PCAP_SAMP_FIRST_AFTER_N_MS               =  2;
const RPCAP_HOSTLIST_SIZE                      =  1024;

alias Pcap_t = void;
alias Pcap_dumper_t = void;

struct Pcap_if_t
{
    Pcap_if_t* next;
    ZString name;
    ZString description;
    Pcap_addr_t* addresses;
    uint flags;
}

struct Pcap_addr_t
{
    Pcap_addr_t* next;
    Sockaddr* addr;
    Sockaddr* netmask;
    Sockaddr* broadaddr;
    Sockaddr* dstaddr;
}

struct Pcap_file_header
{
    uint magic;
    ushort version_major;
    ushort version_minor;
    int thiszone;
    uint sigfigs;
    uint snaplen;
    uint linktype;
}

constdef Pcap_direction_t : CUInt
{
    PCAP_D_INOUT = 0,
    PCAP_D_IN    = 1,
    PCAP_D_OUT   = 2
}

struct Timeval
{
    CLong tv_sec;
    CLong tv_usec;
}

struct Pcap_pkthdr
{
    Timeval ts;
    uint caplen;
    uint len;
}

struct Pcap_stat
{
    uint ps_recv;
    uint ps_drop;
    uint ps_ifdrop;
    uint ps_capt @feat(WIN32);
    uint ps_sent @feat(WIN32);
    uint ps_netdrop @feat(WIN32);
}

struct Pcap_if
{
    Pcap_if* next;
    ZString name;
    ZString description;
    Pcap_addr* addresses;
    uint flags;
}

struct Sockaddr
{
    ushort sa_family;
    char[14] sa_data;
}

struct Pcap_addr
{
    Pcap_addr* next;
    Sockaddr* addr;
    Sockaddr* netmask;
    Sockaddr* broadaddr;
    Sockaddr* dstaddr;
}

alias Pcap_handler = fn void(char*, Pcap_pkthdr*, char*);

